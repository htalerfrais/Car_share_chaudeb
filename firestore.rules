rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function membershipPath(uid, leg) {
      return /databases/$(database)/documents/memberships/$(uid + '__' + leg);
    }

    function carPath(carId) {
      return /databases/$(database)/documents/cars/$(carId);
    }

    function carLeg(data) {
      return ('leg' in data && data.leg == 'retour') ? 'retour' : 'aller';
    }

    function validSeats(value) {
      return (value is int || value is float)
        && value >= 1
        && value <= 8
        && value == math.floor(value);
    }

    function validPublicMember(member) {
      return member is map
        && member.keys().hasOnly(['uid', 'name'])
        && member.uid is string
        && member.uid.size() >= 1
        && member.uid.size() <= 128
        && member.name is string
        && member.name.size() >= 1
        && member.name.size() <= 40;
    }

    function validTrunk(list) {
      return list is list && list.size() <= 200;
    }

    function validDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validCar(data) {
      return data.keys().hasAll([
          'city', 'time', 'seats', 'driver', 'passengers',
          'waitlist', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'city', 'time', 'seats', 'driver', 'passengers',
          'waitlist', 'trunk', 'leg', 'date', 'createdAt', 'updatedAt'
        ])
        && data.city is string
        && data.city.size() >= 2
        && data.city.size() <= 80
        && data.time is string
        && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && validSeats(data.seats)
        && (!('leg' in data) || data.leg in ['aller', 'retour'])
        && (!('date' in data) || validDate(data.date))
        && validPublicMember(data.driver)
        && data.passengers is list
        && data.passengers.size() <= 7
        && data.waitlist is list
        && data.waitlist.size() <= 30
        && (!('trunk' in data) || validTrunk(data.trunk))
        && data.seats >= data.passengers.size() + 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validMembership(data) {
      return data.keys().hasAll(['uid', 'carId', 'role', 'displayName', 'leg', 'createdAt'])
        && data.keys().hasOnly(['uid', 'carId', 'role', 'displayName', 'leg', 'createdAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.carId is string
        && data.carId.size() >= 1
        && data.carId.size() <= 128
        && data.role in ['driver', 'passenger', 'waitlist']
        && data.leg in ['aller', 'retour']
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 40
        && data.createdAt is timestamp;
    }

    function validProfile(data) {
      return data.keys().hasAll(['displayName', 'photoURL', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 40
        && data.photoURL is string
        && data.photoURL.size() >= 1
        && data.photoURL.size() <= 2048
        && data.updatedAt is timestamp;
    }

    function memberFromMembership(data) {
      return {'uid': data.uid, 'name': data.displayName};
    }

    function unchangedCarIdentity() {
      return request.resource.data.driver == resource.data.driver
        && request.resource.data.createdAt == resource.data.createdAt
        && carLeg(request.resource.data) == carLeg(resource.data);
    }

    function trunkOf(data) {
      return 'trunk' in data ? data.trunk : [];
    }

    function sameTrunk() {
      return trunkOf(request.resource.data) == trunkOf(resource.data);
    }

    function driverEditOnly() {
      return request.auth.uid == resource.data.driver.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['city', 'time', 'seats', 'date', 'leg', 'updatedAt'])
        && carLeg(request.resource.data) == carLeg(resource.data)
        && request.resource.data.passengers == resource.data.passengers
        && request.resource.data.waitlist == resource.data.waitlist
        && sameTrunk();
    }

    function trunkEditOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['trunk', 'updatedAt'])
        && request.resource.data.city == resource.data.city
        && request.resource.data.time == resource.data.time
        && request.resource.data.seats == resource.data.seats
        && carLeg(request.resource.data) == carLeg(resource.data)
        && (
          (!('date' in resource.data) && !('date' in request.resource.data))
          || request.resource.data.date == resource.data.date
        )
        && request.resource.data.driver == resource.data.driver
        && request.resource.data.passengers == resource.data.passengers
        && request.resource.data.waitlist == resource.data.waitlist
        && 'trunk' in request.resource.data
        && validTrunk(request.resource.data.trunk);
    }

    // Pas de !exists(membership) : assertFreeForLeg peut supprimer un orphelin
    // puis recréer le membership dans la même transaction (exists reste true avant écriture).
    // La protection anti-double inscription reste sur memberships (update interdit ;
    // delete orphelin seulement si la voiture liée a disparu / plus de présence).
    function joining(carId, listName, role) {
      let leg = carLeg(resource.data);
      let membership = getAfter(membershipPath(request.auth.uid, leg)).data;
      return existsAfter(membershipPath(request.auth.uid, leg))
        && validMembership(membership)
        && membership.uid == request.auth.uid
        && membership.carId == carId
        && membership.role == role
        && membership.leg == leg
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([listName, 'updatedAt'])
        && sameTrunk()
        && request.resource.data[listName].size() == resource.data[listName].size() + 1
        && request.resource.data[listName].hasAll(resource.data[listName])
        && request.resource.data[listName].hasAny([memberFromMembership(membership)]);
    }

    function leaving(carId, listName, role) {
      let leg = carLeg(resource.data);
      let membership = get(membershipPath(request.auth.uid, leg)).data;
      return exists(membershipPath(request.auth.uid, leg))
        && membership.carId == carId
        && membership.role == role
        && membership.leg == leg
        && !existsAfter(membershipPath(request.auth.uid, leg))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([listName, 'updatedAt'])
        && sameTrunk()
        && request.resource.data[listName].size() == resource.data[listName].size() - 1
        && resource.data[listName].hasAny([memberFromMembership(membership)])
        && !request.resource.data[listName].hasAny([memberFromMembership(membership)]);
    }

    function membershipRemovedFromCar(data) {
      return !existsAfter(carPath(data.carId))
        || (
          existsAfter(carPath(data.carId))
          && getAfter(carPath(data.carId)).data.driver.uid != data.uid
          && !getAfter(carPath(data.carId)).data.passengers.hasAny([memberFromMembership(data)])
          && !getAfter(carPath(data.carId)).data.waitlist.hasAny([memberFromMembership(data)])
        );
    }

    // get() sur un membership absent : resource est null, donc ne pas exiger resource.data.
    // Autoriser par chemin (uid connu) pour create/join qui sondent avant d'écrire.
    function isOwnMembershipId(membershipId) {
      return membershipId == request.auth.uid
        || membershipId == request.auth.uid + '__aller'
        || membershipId == request.auth.uid + '__retour';
    }

    function isDriverOfMembershipCar(data) {
      return exists(carPath(data.carId))
        && get(carPath(data.carId)).data.driver.uid == request.auth.uid;
    }

    match /cars/{carId} {
      allow read: if isAuthenticated();

      // Pas de existsAfter(membership) ici : ça créait une dépendance circulaire
      // avec memberships.create → getAfter(car) dans la même transaction.
      allow create: if isAuthenticated()
        && validCar(request.resource.data)
        && request.resource.data.leg in ['aller', 'retour']
        && validDate(request.resource.data.date)
        && request.resource.data.driver.uid == request.auth.uid
        && request.resource.data.passengers.size() == 0
        && request.resource.data.waitlist.size() == 0
        && request.resource.data.trunk.size() == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isAuthenticated()
        && validCar(request.resource.data)
        && unchangedCarIdentity()
        && request.resource.data.updatedAt is timestamp
        && (
          driverEditOnly()
          || trunkEditOnly()
          || joining(carId, 'passengers', 'passenger')
          || joining(carId, 'waitlist', 'waitlist')
          || leaving(carId, 'passengers', 'passenger')
          || leaving(carId, 'waitlist', 'waitlist')
        );

      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.driver.uid
        && !existsAfter(membershipPath(request.auth.uid, carLeg(resource.data)));
    }

    match /memberships/{membershipId} {
      allow get: if isAuthenticated() && (
        isOwnMembershipId(membershipId)
        || (resource != null && isDriverOfMembershipCar(resource.data))
      );
      allow list: if false;

      // Pas de membershipMatchesCar/getAfter(car) à la création : même raison circulaire.
      // L'app crée membership + voiture dans une seule transaction.
      allow create: if isAuthenticated()
        && validMembership(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && membershipId == request.resource.data.uid + '__' + request.resource.data.leg
        && request.resource.data.createdAt is timestamp;

      allow update: if false;

      allow delete: if isAuthenticated()
        && (
          (resource.data.uid == request.auth.uid && membershipRemovedFromCar(resource.data))
          || (
            exists(carPath(resource.data.carId))
            && get(carPath(resource.data.carId)).data.driver.uid == request.auth.uid
            && !existsAfter(carPath(resource.data.carId))
          )
          // Anciens docs memberships/{uid} sans champ leg (avant aller/retour).
          || (
            resource.data.uid == request.auth.uid
            && !('leg' in resource.data)
            && membershipId == resource.data.uid
          )
        );
    }

    match /profiles/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
